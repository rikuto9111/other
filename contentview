// 店情報モデル
struct Shop: Identifiable {//店情報を格納する型
    let id = UUID()//それぞれの店に一意性を持たせる
    let name: String
    let rating: Double
    let coordinate: CLLocationCoordinate2D//緯度経度をもつ型 struct CLLocationCoordinate2D {var latitude: CLLocationDegrees   // 緯度var longitude: CLLocationDegrees  // 経度}
    let isOpennow:Bool
}


actor SearchQueue {
    func run(_ block: @escaping () async -> Void) async {
        await block()
    }
}

// カスタムピン
struct RamenAnnotation: View {//こいつ自身表示させる型 Text imageがある
    var rating: Double
    var name:String
    var isstate:Bool
    //var number:String
    @Binding var isTap:Bool
    @Binding var shopname:String
    
    var shopregularhours:[String]
    @Binding var selectshopregularhours:[String]
    
    @Binding var targetdestination:CLLocationCoordinate2D
    var destination:CLLocationCoordinate2D
    @Binding var selectrating:Double
    
    @Binding var selectshopstate:Bool
    
    var isvisited:Bool
    @Binding var isvisititem:Bool
    
    @Binding var visitid:ObjectId?//初期値が入ってしまっているね
    
    var visitedid:ObjectId?
    
    //@Binding var phonenumber:String
    
    var body: some View {
        VStack(spacing: 2) {
            Text("⭐️\(rating, specifier: "%.1f")")
                .font(.caption2)
                .padding(4)
                .background(Color.white)
                .cornerRadius(6)
                .shadow(radius: 2)
                
                
                
            
                Button(action:{shopname = name
                    targetdestination = destination
                    selectrating = rating
                    selectshopregularhours = shopregularhours
                    selectshopstate = isstate
                    isvisititem = isvisited
                    
                    if let vid = visitedid{//訪問済みならvidに引き渡す
                        
                        visitid = vid
                    }
                    
                    
                    //phonenumber = number
                    isTap.toggle()}){//ボタン押したらその店の名前を呼び出し元と共有する
                        if isstate{//営業時間内
                            Image("ramen") // Assetsにラーメンアイコンを追加
                            
                                .resizable()
                                .foregroundColor(.blue)
                                .frame(width: 32, height: 32)
                            
                        }
                        
                        else{//営業時間外
                            Image("noramen") // Assetsにラーメンアイコンを追加
                            
                                .resizable()
                                .foregroundColor(.blue)
                                .frame(width: 32, height: 32)
                        }
                    }
           // }
            
            
            
            if isvisited{//暫定　ここから　デザイン整えて、重複をなくすことを次行う
                Text("✅")
            }

            
        }
        .frame(width: 80, height: 70, alignment: .bottom)
                .offset(y: -35)
    }
}

