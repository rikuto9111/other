@Observable
class SearchRamenData {//こういう形式になってるらしい

    // ===== JSONレスポンス構造 =====
    struct ResultJson: Codable {//[place:{DisplayName{text},Location:{latitude,logitude}},rating:,place:]..

        struct Place: Codable {

            struct DisplayName: Codable {
                let text: String? //店名
            }

            struct Location: Codable {
                let latitude: Double
                let longitude: Double
            }
            struct OpeningHours: Codable {
                        let openNow: Bool?
                        let weekdayDescriptions: [String]?
                    }
            
            //struct Photo: Codable {
                       // let name: String   // ← 超重要
                    //}
            
            
            let displayName: DisplayName?
            let rating: Double?//Google評価
            let location: Location?//場所
            let currentOpeningHours: OpeningHours?
            let regularOpeningHours: OpeningHours?
            
            //let photos:[Photo]?//photo
        }

        let places: [Place]?
    }

    // ===== 取得結果 =====
    var ramenshops: [RamenShop] = []//こいつの状態が変化したらMainでも表示変更

    // ===== 呼び出し口 =====
    func fetch(latitude: Double, longitude: Double,text:String){
        Task {
            
            let shops = await fetchInternal(latitude: latitude, longitude: longitude, text: text)
            await MainActor.run {
                        self.ramenshops = shops
                    }
        }
    }

    // ===== 実処理 =====
    //@MainActor//本当の非同期処理部分以外 (これで画面を表示する)部分は絶対にメインスレッドで動かす　それでもasyncなのは非同期で行わないと画面が止まってしまう時間のかかる処理があるから

    private func fetchInternal(
        latitude: Double,
        longitude: Double,
        text:String
    ) async -> [RamenShop]{

        guard let url = URL(string: "https://places.googleapis.com/v1/places:searchText")//新形式であり直接url検索できないし,bookapiとかと違って条件が広すぎることと、apiとかを別にして見られないようにっていうので分けてる
        else { return []}

        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.setValue("AIzaSyD9V-EGiuEnL7vgd-m7iP7KmooyILUoxVU", forHTTPHeaderField: "X-Goog-Api-Key")
        request.setValue(//どういうvalueが欲しいのか指定
            "places.displayName,places.rating,places.location,places.id,places.currentOpeningHours,places.regularOpeningHours",
            forHTTPHeaderField: "X-Goog-FieldMask"//検索する対象
        )
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")

        let body: [String: Any] = [//本文の内容に関する条件
            
            "textQuery": "\(text)",
            "languageCode": "ja",
            "locationBias": [//完全な制限にはなっていないってことです!!
                "circle": [
                    "center": [//latitudeとかは現在地
                        "latitude": latitude,
                        "longitude": longitude
                    ],
                    "radius": 10000//後で変更
                ]
            ]
        ]

        do {
            request.httpBody = try JSONSerialization.data(withJSONObject: body)//requestにbodyをくっつけてる

            //ここからが実際の検索
            
            let (data, _) = try await URLSession.shared.data(for: request)//検索が終わるまで非同期の中で待つようにする　そうじゃないと時間かかるからこそ入ってもないのに次の処理を行うことになる

            let json = try JSONDecoder().decode(ResultJson.self, from: data)

            guard let places = json.places else { return []} //json.placesにパコったもの(リスト)が入ってる

            
            var newShops: [RamenShop] = []
            
            for place in places {//パコから一箇所ずつ取り出す
                if let name = place.displayName?.text,
                   let location = place.location {

                    let ramenshop = RamenShop(//Structに嵌め込む
                        name: name,
                        rating: place.rating ?? 0,
                        coordinate: CLLocationCoordinate2D(
                            latitude: location.latitude,
                            longitude: location.longitude
                        ),
                        isOpenNow: place.currentOpeningHours?.openNow ?? false,
                        regularHours: place.regularOpeningHours?.weekdayDescriptions,
                        isvisited: false,
                        vid:nil,
                        visitrating: nil
                    )
                    //ramenshops.append(ramenshop)
                    newShops.append(ramenshop)
                }
            }
            
            return newShops
          
