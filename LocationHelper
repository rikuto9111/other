import CoreLocation

class LocationHelper{//市と県を両方とる
    static func getAreaName(latitude:Double,longitude:Double,completion:@escaping (String,String)-> Void){//非同期処理を行います　Task awaitとはまた別の書き方
        let location = CLLocation(latitude: latitude, longitude: longitude)
        let geocoder = CLGeocoder() //お助けアイテム
        geocoder.reverseGeocodeLocation(location){placemarks,error in //ジオコーディングの逆　　ジオは場所位置  位置 -> 住所 時間のかかる処理
            if let place = placemarks?.first{
                let city = place.locality ?? "不明"
                let prefecture = place.administrativeArea ?? "不明" // locatity => aniministrativeArea => の順にありそう　ないなら不明
                completion(prefecture,city)
                
            }else{
                completion("不明","不明")//完全に終わってからcompletionに渡す
            }
            
        }
        
    }
}
