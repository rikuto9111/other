final class HanteiViewModel: ObservableObject {

    @Published var visitcount = 0
    @Published var displayPrefCount: [(String, Int)] = []
    @Published var displaytypeCount: [String:Int] = [:]
    @Published var mytype = ""
    @Published var isLoading: Bool = true

    @Published var asari: Double = 0
    @Published var kotteri: Double = 0
    @Published var balance: Double = 0

    func recalc(data: [VRamenDatabase]) {

        DispatchQueue.global(qos: .userInitiated).async {

            var pref: [String:Int] = [:]
            var type = ["あっさり系":0,"こってり系":0,"バランス系":0]

            for r in data {

                pref[r.prefecture, default: 0] += 1

                switch r.genre {
                case "塩", "醤油":
                    type["あっさり系", default: 0] += 1
                case "二郎系", "家系", "豚骨":
                    type["こってり系", default: 0] += 1
                default:
                    type["バランス系", default: 0] += 1
                }
            }

            let total = data.count
            let sorted = pref.sorted { $0.value > $1.value }.prefix(2)

            let a = Double(type["あっさり系"] ?? 0) / Double(max(total,1))
            let k = Double(type["こってり系"] ?? 0) / Double(max(total,1))
            let b = Double(type["バランス系"] ?? 0) / Double(max(total,1))

            let result = self.decideType(a: a, k: k, b: b)

            DispatchQueue.main.async {
                self.visitcount = total
                self.displayPrefCount = Array(sorted)
                self.displaytypeCount = type
                self.mytype = result

                // 円グラフ用固定値
                self.asari = a
                self.kotteri = k
                self.balance = b
                
                self.isLoading = false
            }
            
        }
    }

    func decideType(a: Double, k: Double, b: Double) -> String {
        if a >= 0.5 { return "まったり勢" }
        if k >= 0.5 { return "遠征ジャンキー" }
        if b >= 0.5 { return "安定志向" }
        return "バランサー"
    }
}

