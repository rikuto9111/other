enum RamenGenre: String, CaseIterable {//[] は　単なるデータの塊 で同じ型ならなんでも入る,  struct AはAというオブジェクトの属性, enumは自分で指定した種類しか入らないから　それ以外のものは絶対に入らない
    case shoyu = "醤油"//可読性 + コンパイルチェック
    case miso = "味噌"
    case shio = "塩"
    case tonkotsu = "豚骨"
    case iekei = "家系"
    case jiro = "二郎系"
    case tsukemen = "つけ麺"
    case other = "その他"
}

enum RamenGenre2: String, CaseIterable {//RamenGenreにcase allを加えたもの
    case all = "全て"
    case shoyu = "醤油"
    case miso = "味噌"
    case shio = "塩"
    case tonkotsu = "豚骨"
    case iekei = "家系"
    case jiro = "二郎系"
    case tsukemen = "つけ麺"
    case other = "その他"
}


actor SearchQueue {
    func run(_ block: @escaping () async -> Void) async {
        await block()
    }
}


struct ClusterShop: Identifiable {
    let id = UUID()
    let coordinate: CLLocationCoordinate2D
    let count: Int
    let shops: [RamenShop]
}


struct RegionKey: Equatable {
    let lat: Double
    let lon: Double
    let delta: Double
}

struct RingProgressView: View {
    
    var level:Int
    var shougou:String
    var progress: Double // 0.0〜1.0
    var visitcount:Int
    
    var body: some View {
        VStack(spacing:15){
            ZStack {
                Circle()
                    .stroke(Color.gray.opacity(0.2), lineWidth: 10)
                
                Circle()
                    .trim(from: 0, to: progress)
                    .stroke(Color.orange, style: StrokeStyle(lineWidth: 10, lineCap: .round))
                    .rotationEffect(.degrees(-90))
                
                Text("Lv \(String(level))")
                    .bold()
                
            }
            .frame(height:70)
            
            Text(shougou)
            
                .font(.system(size: 20, weight: .bold, design: .serif))
                .foregroundColor(.white)
                .padding(.horizontal, 9)
                .padding(.vertical, 5)
                .background(
                    LinearGradient(
                        colors: [.orange, .red],
                        startPoint: .leading,
                        endPoint: .trailing
                    )
                )
                .cornerRadius(14)
                .shadow(color: .black.opacity(0.2), radius: 6, x: 0, y: 3)
        }
        
        
    }
}






