                .transition(.scale)
            }
            
        }

    
}


extension View {//強制的にこいつを呼び出すとfocusを外す
    func hideKeyboard() {
        UIApplication.shared.sendAction(
            #selector(UIResponder.resignFirstResponder), to: nil, from: nil,
            for: nil)
    }  //UIApplicationアプリ全体の管理を行うみんなのお父さんsharedはそのインスタンス
}

