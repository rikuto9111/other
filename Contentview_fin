// 店情報モデル

// カスタムピン
struct RamenAnnotation: View { // ラーメンアイコン お店の情報

    var rating: Double // お店のGoogle評価
    var name:String // 店名
    var isstate:Bool // 開店しているか否か

    @Binding var isTap:Bool // タップされたかどうか
    @Binding var shopname:String // ContentViewに選択したお店の情報を渡すためにBindingしている
    
    var shopregularhours:[String] // 営業時間
    @Binding var selectshopregularhours:[String]
    
    @Binding var targetdestination:CLLocationCoordinate2D // 座標
    var destination:CLLocationCoordinate2D
    
    @Binding var selectrating:Double // Google 評価
    
    @Binding var selectshopstate:Bool 
    
    var isvisited:Bool  // お店が訪問済みか否か

    @Binding var isvisititem:Bool
    
    @Binding var visitid:ObjectId? //訪問済みお店ID 引き渡し用
    
    var visitedid:ObjectId? //訪問済みお店ID 
    
    var visitrating:Double?//自己評価
    
    @Binding var selimpress:String
    
    @Binding var visititemnum:Int

    
    var body: some View {
        
        let realm = try! Realm()
        
        Button { // アイコンを選択した時
            // ===== データ受け渡し =====
            shopname = name
            targetdestination = destination
            selectrating = rating
            selectshopregularhours = shopregularhours
            selectshopstate = isstate
            isvisititem = isvisited

            if let vid = visitedid { // そのお店が訪問済みなら
                visitid = vid // 受け渡す
                
                
                
                if let object = realm.object(ofType: VRamenDatabase.self, forPrimaryKey: vid) {
                    selimpress = object.isimpress
                    visititemnum = object.visitnumber//選択したアイテムの訪問回数と感想
                }
                
            }

            isTap.toggle() //　このビューを閉じる

        } label: {

            VStack(spacing: 4) {

                // =========================
                // ピン本体（メインアイコン）
