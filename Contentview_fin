enum RamenGenre: String, CaseIterable {
    case shoyu = "醤油"
    case miso = "味噌"
    case shio = "塩"
    case tonkotsu = "豚骨"
    case iekei = "家系"
    case jiro = "二郎系"
    case tsukemen = "つけ麺"
    case other = "その他"
}

