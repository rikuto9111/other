            if let obj = realm.object(ofType: VRamenDatabase.self, forPrimaryKey: vid){//フィルターでも取れるけど主キーならこれが良いかな
                try realm.write{
                    realm.delete(obj)
                }
            }
            visitid = nil
            visititemnum = 0
            isvisititem = false
            
            isTap = false

            
        }catch{
           print("失敗")
        }
        
        
    }
    
